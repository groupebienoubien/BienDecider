{
  "name": "pepito",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/migrate-on-deploy.cjs && next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "test:ux": "playwright test tests/user-journey.spec.ts --workers=1",
    "test:brand": "playwright test tests/brand.spec.ts --workers=1",
    "test:gmail": "playwright test tests/gmail.spec.ts --workers=1",
    "test:facebook": "playwright test tests/facebook.spec.ts --workers=1",
    "test:linkedin": "playwright test tests/linkedin.spec.ts --workers=1",
    "test:delegation": "playwright test tests/delegation.spec.ts --workers=1",
    "test:engine": "playwright test tests/engine.spec.ts --workers=1",
    "test:security": "playwright test tests/security.spec.ts --workers=1",
    "test:session": "node --experimental-strip-types --test tests/session-token.test.mjs",
    "test:voice": "node --experimental-strip-types --test tests/voice.test.mjs tests/chat-stream.test.mjs tests/chat-format.test.mjs",
    "test:database-url": "node --experimental-strip-types --test tests/database-url.test.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.7",
    "google-auth-library": "^11.2.0",
    "jose": "^6.2.12",
    "next": "16.4.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
