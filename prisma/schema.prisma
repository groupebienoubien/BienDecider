// PostgreSQL (Vercel Postgres en prod) — cf. docs/archives/architecture-technique.md.
// L'URL de connexion est définie dans prisma.config.ts / DATABASE_URL, pas ici.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id              String    @id @default(cuid())
  ownerEmail      String    @unique // identifiant de session (login minimal, cf. docs/archives/architecture-technique.md)
  passwordHash    String? // hash+sel (scrypt), jamais en clair — cf. src/lib/password.ts. Null = compte créé avant ce champ (accepte un premier mot de passe au prochain login).
  sessionVersion  Int       @default(0)
  dailyAgentRunLimit       Int       @default(10)
  monthlyAgentRunLimit     Int       @default(100)
  dailyChatMessageLimit    Int       @default(50) // messages à Paul et « Préremplir mon profil » (story 4.1), compteur distinct des lancements
  monthlyChatMessageLimit  Int       @default(500)
  dailySpendLimitUsd       Float     @default(5)
  monthlySpendLimitUsd     Float     @default(25)
  quotaEpoch               Int       @default(0)
  failedLoginAttempts Int @default(0) // anti-force-brute, cf. docs/archives/backlog.md
  lockedUntil     DateTime? // compte verrouillé jusqu'à cette date après trop d'échecs
  name            String
  ownerName       String? // prénom et nom du dirigeant, facultatif : signature des emails rédigés par les agents (story 3.1)
  trade           String // métier, saisi via recherche libre (ex: Restaurant, Plombier...)
  servingArea     String // zone de chalandise
  website         String? // optionnel : beaucoup de TPE n'ont pas de site
  socialHandles   String? // ex: @cabinet_kine_demo (Instagram)
  googlePlaceId          String? // fiche Google confirmée par le dirigeant : le Place ID est le seul contenu Google conservé (conditions Places API)
  googlePlaceCandidateId String? // fiche proposée, en attente de la confirmation du dirigeant
  googlePlaceDeclinedIds String[] @default([]) // fiches refusées ou retirées (les plus récentes) : jamais reproposées
  facebookPageUrl           String? // lien de la Page Facebook confirmé par le dirigeant : seul contenu Facebook conservé
  facebookPageCandidateUrl  String? // lien proposé, en attente de la confirmation du dirigeant
  facebookPageDeclinedUrls  String[] @default([]) // liens refusés ou retirés (les plus récents) : jamais reproposés
  objective       String? // objectif business déclaré, ex: "10 nouveaux clients par mois" (cf. docs/archives/backlog.md #1)
  // Profil business chiffré (cf. docs/archives/backlog.md, "partenaire de croissance") — déclaratif,
  // jamais calculé par Pepito : CA mensuel actuel, cible et échéance, valeur moyenne
  // d'un client (pas "panier" : pour une activité récurrente c'est la valeur sur la
  // durée qui compte). Sert au calcul déterministe de l'écart et du nombre de clients
  // nécessaires (src/lib/business-target.ts), injecté dans les prompts.
  monthlyRevenue     Int? // € / mois
  revenueTarget      Int? // € / mois visés
  targetDate         DateTime?
  averageClientValue Int? // € par client
  newClientsPerMonth Float? // décimal : un rythme annuel converti (6 par an = 0,5 par mois)
  description     String? // description libre de l'activité et du positionnement — remplace l'ancien champ "tone" figé, injectée dans tous les prompts agents
  phone           String? // téléphone affiché aux clients — utilisé par les agents pour éviter les placeholders "[Votre téléphone]"
  certifications  String? // labels/certifications (ex: RGE, Qualibat) — utile pour la crédibilité locale et le contenu généré
  openingHours    String? // horaires d'ouverture, libre — utile pour la fiche Google et le site
  direction       String? // consigne libre du dirigeant pour réorienter Paul et les agents ("Réorienter")
  // Décision CEO du 2026-10-07 (cf. docs/archives/backlog.md "partenaire de croissance") :
  // le dirigeant peut choisir de laisser Pepito prendre contact lui-même avec les
  // prospects validés, par défaut non. Capture la décision dès maintenant ; l'envoi
  // réel reste bloqué tant qu'aucun fournisseur d'envoi n'est configuré (même
  // principe honnête que les connexions OAuth "bientôt" — cf. src/app/connexions).
  autoOutreachEnabled Boolean @default(false)
  siteSlug        String?   @unique // site d'une page hébergé par Pepito : /site/[slug]
  siteHtml        String?
  sitePublishedAt DateTime?
  loginCount      Int       @default(0) // nombre de connexions réussies (vue admin)
  lastLoginAt     DateTime?
  emailVerifiedAt DateTime? @default(now()) // adresse confirmée par le lien envoyé (story 6.4). Défaut = confirmée (comptes antérieurs et fixtures de tests) ; seule l'inscription (src/app/api/auth/signup) crée un compte avec null
  suspendedAt     DateTime? // compte bloqué par un administrateur (story 7.1) : données et site public conservés, plus de session ni de lancement
  createdAt       DateTime  @default(now())
  // Parcours d'entrée en cinq étapes (#279, addendum §4.1) : repris du brouillon anonyme à la création du compte.
  firstName          String? // prénom du dirigeant (étape 1)
  location           String? // localisation de l'entreprise (étape 1)
  targetClients      String? // clients visés (étape 2)
  offers             String? // offres (étape 2)
  profileConfirmedAt DateTime? // profil confirmé à l'étape 2
  ambitionText       String? // ambition en texte libre, conservée telle quelle (étape 3, spec §11)
  ambitionTerms      Json? // éléments retenus avec Paul : gain, horizon, budget média, recrutement (#282, spec §11)
  ambitionConfirmedAt DateTime? // dernière confirmation de l'ambition (« C'est bien ça »)
  brandPrimary       String? // couleur principale confirmée (#290) : #rrggbb
  brandAccent        String? // couleur d'accent confirmée : #rrggbb
  brandTone          String? // ton de marque confirmé : clair | chaleureux | expert
  brandOrigins       Json? // origine de chaque élément confirmé : site, proposal ou declared
  brandProposal      Json? // palette lue sur le site à l'inscription, proposée et non confirmée : { palette, source }
  brandConfirmedAt   DateTime? // dernière confirmation de l'identité de marque ; null = visuels non validables
  profileOrigins     Json? // origine des sept champs de « Corriger mon profil » (#169) : observed, hypothesis, declared ou missing ; absent pour un compte d'avant #169
  channels        ChannelConnection[]
  proposals       AgentProposal[]
  auditFindings   AuditFinding[]
  chatMessages    ChatMessage[]
  planItems       ActionPlanItem[]
  usageEvents     UsageEvent[]
  feedbacks       Feedback[]
  missions        Mission[]
  creditLedger    CreditLedger[]
  creditBalance   Int       @default(20) // credits offerts (D1) ; ne change que par CreditLedger
  creditGrantedAt DateTime? // pose avec l'ecriture des 20 credits offerts dans le registre
  workspaceV52    Boolean   @default(true) // espace V5.2 pour tous depuis le 2026-11-06 ; faux seulement dans les tests de l'ancien parcours, retire avec lui
  priorityMissionId String? // priorite choisie avec Paul (J-08) ; ignoree si la mission est ecartee, close ou absente : la priorite calculee sert alors (spec 2.2)
  journalEntries  JournalEntry[]
  missionContents MissionContent[]
  publications    Publication[]
  sitePages       SitePage[]
  channelAccesses ChannelAccess[]
  delegationLevel String    @default("review") // prepare | review | bounded (spécification §9) ; « Valider avant chaque action » par défaut
  agentRuns       AgentRun[]
  agentRunAttempts AgentRunAttempt[]
  usageReservations UsageReservation[]
  leads           Lead[]
  uncoveredRequests UncoveredRequest[]
  linkedinAuthorizations LinkedInAuthorization[]
  paulPendingActions PaulPendingAction[]
  ideas           Idea[]
  sitePhotos      SitePhoto[]
  sourceReads     SourceRead[]
  emailTokens     EmailToken[]
}

model LinkedInAuthorization {
  stateHash   String   @id
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessionHash String
  nonce       String
  redirectUri String
  expiresAt   DateTime

  @@index([expiresAt])
}

/**
 * Funnel de prospection (cf. docs/archives/backlog.md "partenaire de croissance",
 * phase 3). Un lead = une organisation (entreprise, association,
 * collectivité) identifiée par Jean-Claude via des informations publiques
 * et professionnelles — jamais un particulier. Créé en même temps que la
 * proposition `prospect` (stage "propose"), il n'entre dans le funnel
 * qu'à la validation humaine ("a_contacter"). Les étapes suivantes sont
 * déclarées par le dirigeant : Pepito ne prétend pas connaître les ventes.
 */
model Lead {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proposalId    String?   @unique
  proposal      AgentProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  name          String // organisation ciblée
  reason        String // pourquoi elle correspond à la cible / à l'objectif
  publicContact String? // canal professionnel public (site, téléphone pro, formulaire) — jamais de donnée personnelle
  source        String? // URL ayant permis de l'identifier
  segment       String? // type de cible (ex: "associations", "copropriétés") — base de la boucle d'apprentissage ; "agence" : liste des Partenariats (D6)
  email         String? // agence : e-mail professionnel public, destinataire d'une mission Partenariats
  sector        String? // agence : secteur (immobilier, architecture, syndic…)
  stage         String    @default("propose") // propose, a_contacter, contacte, repondu, rdv, gagne, perdu, ecarte
  contactedAt   DateTime?
  repliedAt     DateTime?
  meetingAt     DateTime?
  closedAt      DateTime?
  statusReason  String? // raison saisie par le dirigeant quand il écarte ou diffère le prospect
  deferredUntil DateTime? // prospect différé : exclu du "prochain prospect" jusqu'à cette date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deliveries    PublicationRecipient[]

  @@unique([companyId, email])
}

/**
 * Trace chaque appel au modèle Claude : companyId, agent à l'origine, modèle
 * utilisé, tokens, coût estimé au tarif du modèle au moment de l'appel.
 * Base de la vue admin (coût par entreprise/agent/modèle) — cf. docs/archives/backlog.md.
 */
model UsageEvent {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agentRunId   String?
  agentRun     AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  agent        String // marketing, contenu, demarchage, co_ceo, site_publish
  model        String // ex: claude-sonnet-5-5
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  createdAt    DateTime @default(now())
  reservationId String? @unique
  reservation   UsageReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
}

model UsageReservation {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purpose     String
  amountUsd   Float    @default(1)
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  releasedAt  DateTime?
  usageEvent  UsageEvent?

  @@index([companyId, expiresAt])
}

/**
 * Plan d'action proposé par Paul (Co-CEO) : "meneur" qui recommande quoi
 * faire, par qui et quand, avant que l'utilisateur ne lance/valide quoi que
 * ce soit (cf. docs/archives/backlog.md — demande CEO "le Co-CEO doit être force de
 * proposition"). Jamais exécuté automatiquement : un item "lancé" ne fait
 * que déclencher l'agent correspondant, qui reste soumis au même garde-fou
 * de validation que partout ailleurs.
 */
model ActionPlanItem {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent       String // marketing, contenu, demarchage
  title       String
  rationale   String
  launchExtras Json? // actualité ou cible de prospection conservée avec la demande ; null pour les actions historiques
  outcome     String? // résultat attendu, une phrase écrite pour le dirigeant (charte, #218) ; null pour les actions antérieures
  timing      String // ex: "cette semaine", "aujourd'hui"
  theme       String?
  priority    Int?
  status      String   @default("propose") // propose, en_cours, lance, termine, ecarte
  feedback    String? // raison donnée par le dirigeant quand il écarte l'action — relue par Paul au plan suivant
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt // story 3.5 : Paul situe chaque état dans le temps
  proposals   AgentProposal[]
  agentRuns   AgentRun[]
}

model AgentRun {
  id                 String         @id @default(cuid())
  companyId          String
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planItemId         String?
  planItem           ActionPlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  agent              String
  requestKey         String
  activeDedupeKey    String?
  payload            Json
  status             String         @default("queued")
  attempts           Int            @default(0)
  reservedCostUsd    Float          @default(1)
  maxDurationSeconds Int            @default(300)
  queuedAt           DateTime       @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  resultCount        Int            @default(0)
  errorMessage       String?
  failureReason      String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  attemptHistory      AgentRunAttempt[]
  usageEvents         UsageEvent[]
  proposals           AgentProposal[]
  auditFindings       AuditFinding[]
  sourceReads         SourceRead[]

  @@unique([companyId, requestKey])
  @@unique([companyId, activeDedupeKey])
  @@index([companyId, status, createdAt])
  @@index([status, queuedAt])
}

model AgentRunAttempt {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agentRunId  String
  agentRun    AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  status      String   @default("queued")
  queuedAt    DateTime @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  errorMessage String?

  @@index([companyId, queuedAt])
  @@index([agentRunId, queuedAt])
}

model ChatMessage {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role        String // user, assistant
  content     String
  contextKey  String   @default("strategie") // conversation de Paul par contexte (spec 16.1) : strategie, mission:{id}, contenu:{id}, resultats, ambition, positionnement, concurrence, sources, idee:{n}
  createdAt   DateTime @default(now())
  pendingActions PaulPendingAction[]

  @@index([companyId, contextKey, createdAt])
}

// Intention proposée par Paul (carte de confirmation) : rien n'est écrit ni
// lancé avant le clic du dirigeant — cf. src/lib/agents/pending-actions.ts.
model PaulPendingAction {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chatMessageId String? // message de Paul qui porte la carte, rattaché à la fin du tour
  chatMessage   ChatMessage? @relation(fields: [chatMessageId], references: [id], onDelete: SetNull)
  type          String // update_profile, mission_priority, mission_scope, mission_pause, mission_dismiss, mission_restore, mission_create, mission_launch (#288), idea_note (#312)
  payload       Json
  status        String       @default("pending") // pending, confirmed, cancelled, expired, superseded (remplacée par une plus récente)
  createdAt     DateTime     @default(now())
  decidedAt     DateTime?
  expiresAt     DateTime

  @@index([companyId, status])
  @@index([chatMessageId])
}

// Photo du site d'une page (story 5.5) : fichier public sur Vercel Blob, sous un chemin propre à l'entreprise.
// Seules ces adresses sont admises dans le HTML généré (src/lib/site/photos.ts).
model SitePhoto {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  url       String
  pathname  String
  alt       String   @default("")
  width     Int
  height    Int
  position  Int
  createdAt DateTime @default(now())

  @@index([companyId])
}

model AuditFinding {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    String // site_web, reseaux_sociaux, concurrence
  title       String
  content     String // résumé court (1-2 phrases) affiché sur la carte compacte — cf. docs/archives/backlog.md "lisibilité des constats"
  // Détail structuré affiché dans la pop-up (nullable : constats créés avant
  // cette structuration n'ont que `content`, affiché tel quel en repli).
  whatWorks   String? // "Ce qui est bien"
  toImprove   String? // "Ce qu'il faut améliorer"
  actionItems Json? // Plan d'action suggéré, potentiellement exécutable par Pepito : { agent, title, rationale }[]
  sourceUrl   String?
  sourceStatus String?
  // Niveau de certitude (#168, prd :101) : observe | piste | a_verifier. « Observé » seulement si la source a été consultée (src/lib/findings/certainty.ts).
  certainty   String   @default("a_verifier")
  agentRunId  String?
  agentRun    AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  missions    Mission[]

  // Plafonds par exécution (story 3.2) : comptés par agentRunId.
  @@index([agentRunId])
}

// Une lecture de source faite par le code (pas déclarée par le modèle) : ce que l'analyse a réellement pu lire. Jamais de contenu Google ici.
model SourceRead {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agentRunId String?
  agentRun   AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  source     String // google_reviews
  target     String // own, competitor
  subject    String? // concurrent demandé par l'agent (sa requête, pas un contenu Google)
  status     String // lue, non_lue
  reason     String? // not_configured, to_confirm, not_found, unavailable
  itemCount  Int? // nombre d'avis lus
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([agentRunId])
}

model ChannelConnection {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel       String // google_business_profile, instagram, facebook
  status        String   @default("non_connecte") // non_connecte, connecte, erreur
  // Jetons OAuth (jamais de mot de passe utilisateur — cf. docs/archives/backlog.md).
  // TODO prod : chiffrer au repos avant d'aller au-delà du pilote (cf.
  // docs/archives/architecture-technique.md § risques techniques).
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())

  @@unique([companyId, channel])
}

model AgentProposal {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agentRunId  String?
  agentRun    AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  agent       String // marketing, contenu, demarchage
  kind        String // ex: gbp_update, review_reply, social_post, prospecting_email
  title       String
  content     String // contenu généré, prêt à être validé/modifié
  status      String   @default("en_attente") // en_attente, validee, modifiee, rejetee, executee ; envois et publications : envoi_en_cours, envoi_incertain, publication_en_cours, publication_incertaine
  // Chaque changement de contenu crée une version ; seule la version approuvée
  // peut être exécutée (US #171). Un brouillon enregistré reste en_attente.
  version         Int       @default(1)
  approvedVersion Int? // null pour les approbations antérieures au versionnage : à reconfirmer avant exécution
  approvedAt      DateTime?
  draftSavedAt    DateTime?
  createdAt   DateTime @default(now())
  decidedAt   DateTime?
  rejectionReason String?
  planItemId  String? // action du plan de Paul dont cette proposition découle (lisibilité plan → agent → proposition)
  planItem    ActionPlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  executionLog ExecutionLog?
  lead        Lead?
  revisions   ProposalRevision[]

  // Plafonds par exécution (story 3.2) : comptés par agentRunId.
  @@index([agentRunId])
}

/// Version précédente d'une production (story 3.3) : contenu de la version fromVersion, et qui a écrit la suivante —
/// l'agent auteur sur consigne du dirigeant (révision), ou le dirigeant lui-même (« Modifier »).
model ProposalRevision {
  id              String        @id @default(cuid())
  proposalId      String
  proposal        AgentProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  fromVersion     Int
  previousContent String
  source          String        @default("agent") // agent (révision demandée via Paul ou le Studio), owner (modification du dirigeant) ou restore (retour à une version précédente)
  instruction     String? // consigne d'une révision ; null pour une modification du dirigeant ; « Retour à la version N » pour un retour
  note            String? // ce que l'agent a changé, en une ou deux phrases (Studio) ; null avant le Studio
  agentRunId      String? // exécution de révision qui a écrit la version fromVersion + 1
  createdAt       DateTime      @default(now())

  // Une version n'est remplacée qu'une fois : l'écriture la fait passer à la suivante.
  @@unique([proposalId, fromVersion])
  @@index([agentRunId])
}

model ExecutionLog {
  id          String   @id @default(cuid())
  proposalId  String   @unique
  proposal    AgentProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  executedAt  DateTime @default(now())
  result      String // succes, echec, incertain
  detail      String?
}

/** Compteur de tentatives d'authentification par adresse IP (hachée), fenêtre fixe — cf. src/lib/auth-throttle.ts. */
model AuthThrottle {
  key         String   @id // scope:HMAC(IP)
  count       Int
  windowStart DateTime

  @@index([windowStart])
}

model DelegationRiskSetting {
  id          String   @id @default(cuid())
  actionKind  String   @unique
  riskLevel   String
  updatedBy   String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

/** Réglage global des inscriptions (story 6.1, #274) : une seule ligne, id "global". Sans ligne : ouvertes et sans plafond. */
model SignupControl {
  id        String   @id @default("global")
  open      Boolean  @default(true)
  dailyCap  Int? // inscriptions acceptées par jour (heure de Paris) ; null = sans plafond
  updatedBy String
  updatedAt DateTime @updatedAt
}

/** Inscriptions acceptées par jour, clé AAAA-MM-JJ en heure de Paris : compteur atomique du plafond. */
model SignupDay {
  day   String @id
  count Int
}

/** Jeton à usage unique envoyé par e-mail (confirmation d'adresse, mot de passe oublié). Seule l'empreinte SHA-256 est conservée : le jeton lui-même n'est jamais stocké. */
model EmailToken {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind      String // verify_email ou reset_password
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([companyId, kind])
}

/**
 * Demande ou objectif d'un dirigeant qu'aucun agent ne couvre. Paul le dit
 * honnêtement, propose ce qui s'en rapproche et note la demande ici, pour
 * que les pères fondateurs voient ce qui manque au catalogue (vue admin).
 */
model UncoveredRequest {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  request            String // ce que le dirigeant voulait, reformulé par Paul sans donnée personnelle de tiers
  closestAlternative String? // ce que Paul a proposé à la place
  source             String // chat, plan, mission
  createdAt          DateTime @default(now())
}

/** Seuils d'alerte de consommation (story 7.3, #72) : une seule ligne, id "global". Sans ligne : 3 $ par entreprise et 10 $ au total, par jour de Paris. */
model UsageAlertSetting {
  id              String   @id @default("global")
  companyDailyUsd Float    @default(3)
  totalDailyUsd   Float    @default(10)
  updatedBy       String
  updatedAt       DateTime @updatedAt
}

/** Alerte de consommation : au plus une par jour (AAAA-MM-JJ, heure de Paris) et par portée (company:<id> ou total). L'entreprise n'est pas une relation : l'historique survit à sa suppression. */
model UsageAlert {
  id           String   @id @default(cuid())
  day          String
  scope        String
  label        String // nom de l'entreprise au moment de l'alerte, ou « Total »
  thresholdUsd Float
  costUsd      Float
  createdAt    DateTime @default(now())

  @@unique([day, scope])
  @@index([createdAt])
}

/// Signalement laisse par un dirigeant depuis n'importe quelle page connectee (story 7.4, #275).
model Feedback {
  id        String    @id @default(cuid())
  companyId String
  kind      String // problem | confusion | idea
  page      String // chemin seul, sans parametres ni fragment
  text      String
  handledAt DateTime? // null = a traiter
  createdAt DateTime  @default(now())
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([createdAt])
}

/// Erreur serveur tracee (story 8.1, #83) : message nettoye de tout secret, chemin sans parametres.
model ErrorEvent {
  id          String   @id @default(cuid())
  fingerprint String
  message     String
  path        String
  method      String
  routeType   String?
  digest      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([fingerprint, createdAt])
}

/// Solde constate chez le fournisseur du modele (story 8.2, #62) : le restant est calcule depuis la consommation mesuree.
model LlmCreditSetting {
  id            String   @id @default("global")
  balanceUsd    Float
  balanceAt     DateTime
  alertBelowUsd Float    @default(5)
  updatedBy     String
  updatedAt     DateTime @updatedAt
}

/// Mission (story 9.1, #277) : test limite issu d'un constat. Table neuve, sans reprise de l'ancien plan d'action (decision du 2026-11-05).
model Mission {
  id                  String         @id @default(cuid())
  companyId           String
  template            String // agencies, leads, proof, social_post, google_profile, review_reply, site_page, custom
  channel             String? // facebook, instagram, linkedin, google_business_profile, gmail, site ; null = hors canal (Sur mesure)
  stopRuleDays        Int?
  title               String
  outcome             String // resultat recherche
  originalOutcome     String // resultat recherche a la creation
  finding             String
  // Provenance (#168) : constat du diagnostic d'où vient la mission, et ce que Paul en a déduit ; nuls pour les missions du dirigeant et les anciennes.
  sourceFindingId     String?
  sourceFinding       AuditFinding?  @relation(fields: [sourceFindingId], references: [id], onDelete: SetNull)
  deduction           String?
  // US #284 : agent responsable (clé de PERSONAS, affiché comme un rôle de Paul) et risque ou limite (10 à 200 caractères, sans balise) ; nuls pour les missions du dirigeant et les anciennes.
  responsibleAgent    String?
  risk                String?
  createdBy           String         @default("owner") // paul | owner
  status              String         @default("proposed") // proposed, active, paused, stopped, dismissed
  previousStatus      String? // pour « Remettre au plan »
  position            Int
  scope               Json           @default("{}")
  contactsConfirmedAt DateTime?
  firstLaunchedAt     DateTime? // le debit du lancement n'a lieu qu'une fois
  hasValidatedVersion Boolean        @default(false) // pose par la validation d'une version (atelier) ; fige le canal
  version             Int            @default(1) // concurrence optimiste
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  company             Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  credits             CreditLedger[]
  content             MissionContent?
  sitePage            SitePage?
  reports             MissionReport[]
  decisions           MissionDecision[]

  @@index([companyId, status])
  @@index([sourceFindingId])
}

/// Idee notee avec Paul (US #312, addendum §4.5) : pas encore une mission. Ouverte tant que convertedMissionId est nul ;
/// retiree = supprimee, cadree = convertedMissionId pose dans la transaction de creation de la mission.
model Idea {
  id                 String   @id @default(cuid())
  companyId          String
  text               String // 1 a 200 caracteres, sans < ni > (M-62)
  createdAt          DateTime @default(now())
  convertedMissionId String? // mission creee depuis cette idee
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

/// Bilan déclaré d'une mission (§7.1, #294) : le dernier fait foi ; « à jour » tant que le nombre de diffusions n'a pas changé.
model MissionReport {
  id               String            @id @default(cuid())
  missionId        String
  qualifiedLeads   Int
  meetings         Int // <= qualifiedLeads (contrainte CHECK dans la migration)
  signedRevenue    Int? // null : non déclaré, jamais zéro
  note             String? // 600 caractères au plus
  publicationCount Int // diffusions de la mission au moment de la saisie
  createdAt        DateTime          @default(now())
  mission          Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  decisions        MissionDecision[]

  @@index([missionId, createdAt])
}

/// Décision de suite (§7.2, #52) : poursuivre ou arrêter ; la dernière fait foi.
model MissionDecision {
  id               String         @id @default(cuid())
  missionId        String
  choice           String // continue | stop
  publicationCount Int
  reportId         String?
  createdAt        DateTime       @default(now())
  mission          Mission        @relation(fields: [missionId], references: [id], onDelete: Cascade)
  report           MissionReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([missionId, createdAt])
}

/// Registre des credits en ajout seul (story 9.3, #56) : chaque mouvement, avec le solde apres.
model CreditLedger {
  id           String   @id @default(cuid())
  companyId    String
  delta        Int
  kind         String // grant | mission_launch | paul_version
  label        String
  missionId    String?
  balanceAfter Int
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mission      Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

/// Journal des decisions et evenements (spec §15) : un code et ses parametres, le texte est rendu a l'affichage.
model JournalEntry {
  id        String   @id @default(cuid())
  companyId String
  missionId String?
  code      String // J-01 ... J-29
  actor     String   @default("owner") // owner | paul | system
  params    Json     @default("{}")
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([missionId])
}

/// Contenu d'une mission (story 11.1, #289) : ce qui partira sur le canal, version par version.
model MissionContent {
  id              String           @id @default(cuid())
  companyId       String
  missionId       String
  channel         String? // canal de la mission a la creation du contenu ; null = hors canal
  format          String // social_post, email, site_page, google_post, text
  currentNumber   Int              @default(0)
  validatedNumber Int? // valide si egal a currentNumber
  validatedAt     DateTime?
  suggestion      Json? // variante proposee par Paul, creee seulement a l'acceptation
  visualComposition String? // composition du visuel (#290) : photo_signature | cadre_editorial ; null = pas de visuel
  version         Int              @default(1) // concurrence optimiste
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mission         Mission          @relation(fields: [missionId], references: [id], onDelete: Cascade)
  versions        ContentVersion[]
  publications    Publication[]

  @@unique([missionId]) // un contenu par mission pour le PoC
  @@index([companyId])
}

/// Version d'un contenu : jamais modifiee apres creation, sauf son refus motive (#22).
model ContentVersion {
  id              String         @id @default(cuid())
  contentId       String
  number          Int
  title           String // accroche ou objet, 1 a 100
  body            String // 1 a 3000
  author          String // owner | paul | system
  note            String?
  rejectedAt      DateTime?
  rejectionReason String?
  brandSnapshot   Json? // instantané de la marque à la création de la version (#290) : nom, palette, ton, composition ; les archives ne bougent pas
  createdAt       DateTime       @default(now())
  content         MissionContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, number])
}

/// Diffusion d'une version (stories 12.1 et 12.2, #315 #295 ; addendum 4.3) : confirmee par BienDecider ou declaree par le dirigeant.
model Publication {
  id             String         @id @default(cuid())
  companyId      String
  missionId      String
  contentId      String
  versionNumber  Int
  title          String
  channel        String? // canal de la mission ; null = hors canal, diffusion declaree
  channelLabel   String // destination en clair : Page Facebook, adresse du site, canal declare
  mode           String // confirmed | declared
  status         String // scheduled | sending | sent | failed | uncertain | cancelled
  scheduledAt    DateTime? // UTC (#261)
  timezone       String?
  sentAt         DateTime?
  recipientCount Int?
  externalId     String? // identifiant renvoye par le canal
  url            String? // adresse publique, si le canal en donne une
  failureReason  String? // en clair (J-28)
  cancelReason   String? // J-23
  cancelledBy    String? // owner | system : une annulation par le système remonte dans « À valider par vous »
  idempotencyKey String         @unique // contenu, version et rang de la tentative : deux confirmations simultanees n'en font qu'une
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  content        MissionContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  recipients     PublicationRecipient[]

  @@index([status, scheduledAt])
  @@index([contentId])
}

/// E-mail : un envoi par destinataire (addendum §4.3), chacun avec son résultat ; une adresse n'est servie qu'une fois par diffusion.
model PublicationRecipient {
  id            String      @id @default(cuid())
  publicationId String
  leadId        String?
  name          String
  email         String
  status        String // sending | sent | failed | uncertain
  externalId    String? // identifiant du message renvoyé par Gmail
  failureReason String?
  sentAt        DateTime?
  createdAt     DateTime    @default(now())
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  lead          Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([publicationId, email])
  @@index([leadId])
}

/// Page du site vitrine mise en ligne par une diffusion (#172) : exactement la version validee et confirmee, servie sous /site/{siteSlug}/{slug}.
model SitePage {
  id            String   @id @default(cuid())
  companyId     String
  missionId     String   @unique
  slug          String
  title         String
  body          String
  versionNumber Int
  publishedAt   DateTime
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mission       Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([companyId, slug])
}

/// Ouverture d'un canal actif (#301) : tant que le fournisseur n'a pas approuve l'application, l'administrateur peut le reserver aux entreprises autorisees. Sans ligne : ouvert a tous.
model ChannelRollout {
  channel   String   @id
  openToAll Boolean  @default(true)
  updatedBy String?
  updatedAt DateTime @updatedAt
}

/// Acces d'une entreprise a un canal reserve (#301) : demande par le dirigeant, accordee par un administrateur.
model ChannelAccess {
  id          String    @id @default(cuid())
  companyId   String
  channel     String
  status      String // requested | granted
  requestedAt DateTime?
  grantedAt   DateTime?
  grantedBy   String?
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, channel])
}

/// Brouillon anonyme du parcours d'entrée (#279, addendum §6) : lié au cookie `pepito_draft` (24 h) dont seule l'empreinte SHA-256 est gardée. Aucune entreprise ni mission n'existe avant l'étape 5.
model OnboardingDraft {
  id                String   @id @default(cuid())
  tokenHash         String   @unique
  step              Int      @default(1) // étape courante, 1 à 5
  profile           Json // prénom, entreprise, localisation, site, activité, zone, clients, offres
  ambition          Json? // { text, terms } (#282)
  profileConfirmed  Boolean  @default(false)
  diagnosticReady   Boolean  @default(false)
  analysis          Json? // analyse publique avant compte (#280) : rubriques, constats et leur provenance, coût estimé
  createdAt         DateTime @default(now())
  expiresAt         DateTime

  @@index([expiresAt])
}
