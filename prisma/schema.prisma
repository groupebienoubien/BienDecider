// PostgreSQL (Vercel Postgres en prod) — cf. docs/architecture-technique.md.
// L'URL de connexion est définie dans prisma.config.ts / DATABASE_URL, pas ici.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id              String    @id @default(cuid())
  ownerEmail      String    @unique // identifiant de session (login minimal, cf. docs/architecture-technique.md)
  passwordHash    String? // hash+sel (scrypt), jamais en clair — cf. src/lib/password.ts. Null = compte créé avant ce champ (accepte un premier mot de passe au prochain login).
  sessionVersion  Int       @default(0)
  dailyAgentRunLimit       Int       @default(10)
  monthlyAgentRunLimit     Int       @default(100)
  dailySpendLimitUsd       Float     @default(5)
  monthlySpendLimitUsd     Float     @default(25)
  quotaEpoch               Int       @default(0)
  failedLoginAttempts Int @default(0) // anti-force-brute, cf. docs/backlog.md
  lockedUntil     DateTime? // compte verrouillé jusqu'à cette date après trop d'échecs
  name            String
  ownerName       String? // prénom et nom du dirigeant, facultatif : signature des emails rédigés par les agents (story 3.1)
  trade           String // métier, saisi via recherche libre (ex: Restaurant, Plombier...)
  servingArea     String // zone de chalandise
  website         String? // optionnel : beaucoup de TPE n'ont pas de site
  socialHandles   String? // ex: @cabinet_kine_demo (Instagram)
  objective       String? // objectif business déclaré, ex: "10 nouveaux clients par mois" (cf. docs/backlog.md #1)
  // Profil business chiffré (cf. docs/backlog.md, "partenaire de croissance") — déclaratif,
  // jamais calculé par Pepito : CA mensuel actuel, cible et échéance, valeur moyenne
  // d'un client (pas "panier" : pour une activité récurrente c'est la valeur sur la
  // durée qui compte). Sert au calcul déterministe de l'écart et du nombre de clients
  // nécessaires (src/lib/business-target.ts), injecté dans les prompts.
  monthlyRevenue     Int? // € / mois
  revenueTarget      Int? // € / mois visés
  targetDate         DateTime?
  averageClientValue Int? // € par client
  newClientsPerMonth Float? // décimal : un rythme annuel converti (6 par an = 0,5 par mois)
  description     String? // description libre de l'activité et du positionnement — remplace l'ancien champ "tone" figé, injectée dans tous les prompts agents
  phone           String? // téléphone affiché aux clients — utilisé par les agents pour éviter les placeholders "[Votre téléphone]"
  certifications  String? // labels/certifications (ex: RGE, Qualibat) — utile pour la crédibilité locale et le contenu généré
  openingHours    String? // horaires d'ouverture, libre — utile pour la fiche Google et le site
  direction       String? // consigne libre du dirigeant pour réorienter Paul et les agents ("Réorienter")
  // Décision CEO du 2026-10-07 (cf. docs/backlog.md "partenaire de croissance") :
  // le dirigeant peut choisir de laisser Pepito prendre contact lui-même avec les
  // prospects validés, par défaut non. Capture la décision dès maintenant ; l'envoi
  // réel reste bloqué tant qu'aucun fournisseur d'envoi n'est configuré (même
  // principe honnête que les connexions OAuth "bientôt" — cf. src/app/connexions).
  autoOutreachEnabled Boolean @default(false)
  siteSlug        String?   @unique // site d'une page hébergé par Pepito : /site/[slug]
  siteHtml        String?
  sitePublishedAt DateTime?
  loginCount      Int       @default(0) // nombre de connexions réussies (vue admin)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  channels        ChannelConnection[]
  proposals       AgentProposal[]
  auditFindings   AuditFinding[]
  chatMessages    ChatMessage[]
  planItems       ActionPlanItem[]
  usageEvents     UsageEvent[]
  agentRuns       AgentRun[]
  agentRunAttempts AgentRunAttempt[]
  usageReservations UsageReservation[]
  leads           Lead[]
  uncoveredRequests UncoveredRequest[]
  linkedinAuthorizations LinkedInAuthorization[]
  paulPendingActions PaulPendingAction[]
}

model LinkedInAuthorization {
  stateHash   String   @id
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessionHash String
  nonce       String
  redirectUri String
  expiresAt   DateTime

  @@index([expiresAt])
}

/**
 * Funnel de prospection (cf. docs/backlog.md "partenaire de croissance",
 * phase 3). Un lead = une organisation (entreprise, association,
 * collectivité) identifiée par Jean-Claude via des informations publiques
 * et professionnelles — jamais un particulier. Créé en même temps que la
 * proposition `prospect` (stage "propose"), il n'entre dans le funnel
 * qu'à la validation humaine ("a_contacter"). Les étapes suivantes sont
 * déclarées par le dirigeant : Pepito ne prétend pas connaître les ventes.
 */
model Lead {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proposalId    String?   @unique
  proposal      AgentProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  name          String // organisation ciblée
  reason        String // pourquoi elle correspond à la cible / à l'objectif
  publicContact String? // canal professionnel public (site, téléphone pro, formulaire) — jamais de donnée personnelle
  source        String? // URL ayant permis de l'identifier
  segment       String? // type de cible (ex: "associations", "copropriétés") — base de la boucle d'apprentissage
  stage         String    @default("propose") // propose, a_contacter, contacte, repondu, rdv, gagne, perdu, ecarte
  contactedAt   DateTime?
  repliedAt     DateTime?
  meetingAt     DateTime?
  closedAt      DateTime?
  statusReason  String? // raison saisie par le dirigeant quand il écarte ou diffère le prospect
  deferredUntil DateTime? // prospect différé : exclu du "prochain prospect" jusqu'à cette date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/**
 * Trace chaque appel au modèle Claude : companyId, agent à l'origine, modèle
 * utilisé, tokens, coût estimé au tarif du modèle au moment de l'appel.
 * Base de la vue admin (coût par entreprise/agent/modèle) — cf. docs/backlog.md.
 */
model UsageEvent {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agentRunId   String?
  agentRun     AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  agent        String // marketing, contenu, demarchage, co_ceo, site_publish
  model        String // ex: claude-sonnet-5-5
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  createdAt    DateTime @default(now())
  reservationId String? @unique
  reservation   UsageReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
}

model UsageReservation {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purpose     String
  amountUsd   Float    @default(1)
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  releasedAt  DateTime?
  usageEvent  UsageEvent?

  @@index([companyId, expiresAt])
}

/**
 * Plan d'action proposé par Paul (Co-CEO) : "meneur" qui recommande quoi
 * faire, par qui et quand, avant que l'utilisateur ne lance/valide quoi que
 * ce soit (cf. docs/backlog.md — demande CEO "le Co-CEO doit être force de
 * proposition"). Jamais exécuté automatiquement : un item "lancé" ne fait
 * que déclencher l'agent correspondant, qui reste soumis au même garde-fou
 * de validation que partout ailleurs.
 */
model ActionPlanItem {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent       String // marketing, contenu, demarchage
  title       String
  rationale   String
  outcome     String? // résultat attendu, une phrase écrite pour le dirigeant (charte, #218) ; null pour les actions antérieures
  timing      String // ex: "cette semaine", "aujourd'hui"
  theme       String?
  priority    Int?
  status      String   @default("propose") // propose, en_cours, lance, termine, ecarte
  feedback    String? // raison donnée par le dirigeant quand il écarte l'action — relue par Paul au plan suivant
  createdAt   DateTime @default(now())
  proposals   AgentProposal[]
  agentRuns   AgentRun[]
}

model AgentRun {
  id                 String         @id @default(cuid())
  companyId          String
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planItemId         String?
  planItem           ActionPlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  agent              String
  requestKey         String
  activeDedupeKey    String?
  payload            Json
  status             String         @default("queued")
  attempts           Int            @default(0)
  reservedCostUsd    Float          @default(1)
  maxDurationSeconds Int            @default(300)
  queuedAt           DateTime       @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  resultCount        Int            @default(0)
  errorMessage       String?
  failureReason      String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  attemptHistory      AgentRunAttempt[]
  usageEvents         UsageEvent[]
  proposals           AgentProposal[]
  auditFindings       AuditFinding[]

  @@unique([companyId, requestKey])
  @@unique([companyId, activeDedupeKey])
  @@index([companyId, status, createdAt])
  @@index([status, queuedAt])
}

model AgentRunAttempt {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agentRunId  String
  agentRun    AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  status      String   @default("queued")
  queuedAt    DateTime @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  errorMessage String?

  @@index([companyId, queuedAt])
  @@index([agentRunId, queuedAt])
}

model ChatMessage {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role        String // user, assistant
  content     String
  createdAt   DateTime @default(now())
  pendingActions PaulPendingAction[]
}

// Intention proposée par Paul (carte de confirmation) : rien n'est écrit ni
// lancé avant le clic du dirigeant — cf. src/lib/agents/pending-actions.ts.
model PaulPendingAction {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chatMessageId String? // message de Paul qui porte la carte, rattaché à la fin du tour
  chatMessage   ChatMessage? @relation(fields: [chatMessageId], references: [id], onDelete: SetNull)
  type          String // update_objective (2.2 et 2.3 ajoutent leurs types)
  payload       Json
  status        String       @default("pending") // pending, confirmed, cancelled, expired, superseded (remplacée par une plus récente)
  createdAt     DateTime     @default(now())
  decidedAt     DateTime?
  expiresAt     DateTime

  @@index([companyId, status])
  @@index([chatMessageId])
}

model AuditFinding {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    String // site_web, reseaux_sociaux, concurrence
  title       String
  content     String // résumé court (1-2 phrases) affiché sur la carte compacte — cf. docs/backlog.md "lisibilité des constats"
  // Détail structuré affiché dans la pop-up (nullable : constats créés avant
  // cette structuration n'ont que `content`, affiché tel quel en repli).
  whatWorks   String? // "Ce qui est bien"
  toImprove   String? // "Ce qu'il faut améliorer"
  actionItems Json? // Plan d'action suggéré, potentiellement exécutable par Pepito : { agent, title, rationale }[]
  sourceUrl   String?
  sourceStatus String?
  agentRunId  String?
  agentRun    AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model ChannelConnection {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  channel       String // google_business_profile, instagram, facebook
  status        String   @default("non_connecte") // non_connecte, connecte, erreur
  // Jetons OAuth (jamais de mot de passe utilisateur — cf. docs/backlog.md).
  // TODO prod : chiffrer au repos avant d'aller au-delà du pilote (cf.
  // docs/architecture-technique.md § risques techniques).
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())

  @@unique([companyId, channel])
}

model AgentProposal {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agentRunId  String?
  agentRun    AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  agent       String // marketing, contenu, demarchage
  kind        String // ex: gbp_update, review_reply, social_post, prospecting_email
  title       String
  content     String // contenu généré, prêt à être validé/modifié
  status      String   @default("en_attente") // en_attente, validee, modifiee, rejetee, executee ; envois et publications : envoi_en_cours, envoi_incertain, publication_en_cours, publication_incertaine
  // Chaque changement de contenu crée une version ; seule la version approuvée
  // peut être exécutée (US #171). Un brouillon enregistré reste en_attente.
  version         Int       @default(1)
  approvedVersion Int? // null pour les approbations antérieures au versionnage : à reconfirmer avant exécution
  approvedAt      DateTime?
  draftSavedAt    DateTime?
  createdAt   DateTime @default(now())
  decidedAt   DateTime?
  rejectionReason String?
  planItemId  String? // action du plan de Paul dont cette proposition découle (lisibilité plan → agent → proposition)
  planItem    ActionPlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  executionLog ExecutionLog?
  lead        Lead?
}

model ExecutionLog {
  id          String   @id @default(cuid())
  proposalId  String   @unique
  proposal    AgentProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  executedAt  DateTime @default(now())
  result      String // succes, echec, incertain
  detail      String?
}

/** Compteur de tentatives d'authentification par adresse IP (hachée), fenêtre fixe — cf. src/lib/auth-throttle.ts. */
model AuthThrottle {
  key         String   @id // scope:HMAC(IP)
  count       Int
  windowStart DateTime

  @@index([windowStart])
}

model DelegationRiskSetting {
  id          String   @id @default(cuid())
  actionKind  String   @unique
  riskLevel   String
  updatedBy   String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

/**
 * Demande ou objectif d'un dirigeant qu'aucun agent ne couvre. Paul le dit
 * honnêtement, propose ce qui s'en rapproche et note la demande ici, pour
 * que les pères fondateurs voient ce qui manque au catalogue (vue admin).
 */
model UncoveredRequest {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  request            String // ce que le dirigeant voulait, reformulé par Paul sans donnée personnelle de tiers
  closestAlternative String? // ce que Paul a proposé à la place
  source             String // chat, plan
  createdAt          DateTime @default(now())
}
