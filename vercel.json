{
  "buildCommand": "npm run vercel-build",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/weekly-review",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/drafts",
      "schedule": "30 3 * * *"
    }
  ]
}
